#!/bin/bash
# Runs inside cage: applies the saved display settings, then starts the web browser:
# Firefox, or Google Chrome when it is installed and chosen in the EAGLE menu > Web browser.

HOME_URL="moz-extension://6f1c2e8a-3b7d-4e59-9a0b-5e61a9e00001/start.html"
KIOSK=0
# shellcheck source=/dev/null
[ -r /etc/eagle/eagle.conf ] && . /etc/eagle/eagle.conf

CONF="$HOME/.config/eagle"
# Saved by eagle-setup: OUTPUT, MODE (e.g. 1366x768@60.000000), SCALE (e.g. 1.25)
if [ -r "$CONF/display" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  # shellcheck source=/dev/null
  . "$CONF/display"
  if [ -n "${OUTPUT:-}" ]; then
    randr=(wlr-randr --output "$OUTPUT")
    [ -n "${MODE:-}" ] && randr+=(--mode "$MODE")
    [ -n "${SCALE:-}" ] && randr+=(--scale "$SCALE")
    "${randr[@]}" || true
  fi
fi

# ---------- Google Chrome ----------
BROWSER=$(cat "$CONF/browser" 2>/dev/null || echo firefox)
if [ "$BROWSER" = chrome ] && command -v google-chrome-stable >/dev/null && [ -r /usr/share/eagle/chrome/id ]; then
  CHROME_ID=$(cat /usr/share/eagle/chrome/id)
  DATA="$HOME/.eagle-chrome"
  mkdir -p "$DATA/Default"
  # no "Chrome didn't shut down correctly" bubble: EAGLE closes Chrome when it opens its screens
  sed -i 's/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' "$DATA/Default/Preferences" 2>/dev/null
  args=(--user-data-dir="$DATA" --no-first-run --no-default-browser-check --password-store=basic
        --start-maximized --disable-session-crashed-bubble)
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then args+=(--ozone-platform=wayland --enable-features=UseOzonePlatform); else args+=(--ozone-platform=x11); fi
  mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  [ "${mem_kb:-0}" -le 4194304 ] && args+=(--renderer-process-limit=4)
  [ "$KIOSK" = "1" ] && args+=(--kiosk)
  exec google-chrome-stable "${args[@]}" "chrome-extension://$CHROME_ID/start.html"
fi

# ---------- Firefox ----------
# Wayland normally; X11 in the basic-display fallback
if [ -n "${WAYLAND_DISPLAY:-}" ]; then export MOZ_ENABLE_WAYLAND=1; else unset MOZ_ENABLE_WAYLAND; fi

# One fixed profile: EAGLE theme always; low-memory tuning on PCs with 4 GB RAM or less;
# EAGLE-OS Lite always gets low-memory plus slow-processor tuning.
PROFILE="$HOME/.eagle-profile"
mkdir -p "$PROFILE"
cp -f /etc/eagle/base-user.js "$PROFILE/user.js"
mkdir -p "$PROFILE/chrome"
cp -f /etc/eagle/userChrome.css "$PROFILE/chrome/userChrome.css"
VARIANT=$(cat /etc/eagle/variant 2>/dev/null || echo standard)
mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
if [ "$VARIANT" = "lite" ] || [ "${mem_kb:-0}" -le 4194304 ]; then
  cat /etc/eagle/lowmem-user.js >> "$PROFILE/user.js"
fi
if [ "$VARIANT" = "lite" ]; then
  cat /etc/eagle/lite-user.js >> "$PROFILE/user.js"
fi

args=(--no-remote --profile "$PROFILE")
[ "$KIOSK" = "1" ] && args+=(--kiosk)

exec firefox-esr "${args[@]}" "$HOME_URL"

#!/bin/bash
# The whole "desktop": optional Wi-Fi setup screen, then Firefox full screen.
# greetd relaunches this script whenever it exits.

HOME_URL="https://www.google.com"
KIOSK=0
# shellcheck source=/dev/null
[ -r /etc/eagle/eagle.conf ] && . /etc/eagle/eagle.conf

export MOZ_ENABLE_WAYLAND=1
# Old or unsupported graphics chips: fall back to software drawing instead of a black screen.
export WLR_RENDERER_ALLOW_SOFTWARE=1

# One fixed Firefox profile, tuned for low memory when the PC has 4 GB or less.
PROFILE="$HOME/.eagle-profile"
mkdir -p "$PROFILE"
mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
if [ "${mem_kb:-0}" -le 4194304 ]; then
  cp -f /etc/eagle/lowmem-user.js "$PROFILE/user.js"
else
  rm -f "$PROFILE/user.js"
fi

# No network yet? Show a Wi-Fi picker first.
if ! nm-online --quiet --timeout=20; then
  cage -s -- foot --title "Connect to Wi-Fi" nmtui-connect
fi

args=(--no-remote --profile "$PROFILE")
if [ "$KIOSK" = "1" ]; then
  args+=(--kiosk)
fi

exec cage -s -- firefox-esr "${args[@]}" "$HOME_URL"

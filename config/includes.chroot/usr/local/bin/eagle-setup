#!/bin/bash
# EAGLE-OS setup and menu screen (runs in a full-screen terminal under cage).
#   eagle-setup --first-run   welcome, Wi-Fi, display, sound, then start browsing
#   eagle-setup --menu        shown when Firefox is closed: adds Updates / Install / Restart / Shut down
#   eagle-setup --action X    open one screen (wifi, display, sound, datetime, disks, security, updates, install, menu) and return

MODE_ARG="${1:---menu}"
ACTION_ARG="${2:-}"
CONF="$HOME/.config/eagle"
DISPLAY_FILE="$CONF/display"
mkdir -p "$CONF"

# Black / grey / orange screens
# shellcheck source=/dev/null
. /usr/local/lib/eagle/newt-colors.sh

TITLE="EAGLE-OS"
whiptail() { command whiptail --notags "$@"; }   # menus show labels only
H=20; W=72

net_status() {
  local active
  active=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | grep -v ':loopback$' | head -n1 | cut -d: -f1)
  if [ -n "$active" ]; then echo "Connected: $active"; else echo "Not connected"; fi
}

# ---------- Wi-Fi ----------
wifi_setup() {
  nmcli radio wifi on >/dev/null 2>&1
  nmtui-connect
}

# ---------- Display ----------
load_display() { OUTPUT=""; MODE=""; SCALE=""; [ -r "$DISPLAY_FILE" ] && . "$DISPLAY_FILE"; }
save_display() { printf 'OUTPUT=%q\nMODE=%q\nSCALE=%q\n' "$OUTPUT" "$MODE" "$SCALE" > "$DISPLAY_FILE"; }

pick_output() {
  local outs=() items=() o
  mapfile -t outs < <(wlr-randr 2>/dev/null | awk '/^[^ ]/ {print $1}')
  if [ "${#outs[@]}" -eq 0 ]; then
    whiptail --title "$TITLE · Display" --msgbox "No screen settings are available on this PC. It will use its default resolution." 9 $W
    return 1
  fi
  if [ "${#outs[@]}" -eq 1 ]; then OUTPUT="${outs[0]}"; return 0; fi
  for o in "${outs[@]}"; do items+=("$o" ""); done
  OUTPUT=$(whiptail --title "$TITLE · Display" --menu "Which screen?" $H $W 12 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
}

pick_resolution() {
  local items=() line mode tag current=""
  while read -r line; do
    mode="${line%% *}"; tag="${line#* }"
    [ "$tag" = "current" ] && current="$mode"
    [ "$tag" = "$mode" ] && tag=""
    items+=("$mode" "$tag")
  done < <(wlr-randr 2>/dev/null | awk -v o="$OUTPUT" '
      /^[^ ]/ {cur=$1; next}
      cur==o && /px,/ {
        m=$1"@"$3; t=""
        if ($0 ~ /current/) t="current"; else if ($0 ~ /preferred/) t="recommended"
        if (!(m in seen)) {seen[m]=1; print (t=="" ? m : m" "t)}
      }')
  if [ "${#items[@]}" -eq 0 ]; then
    whiptail --title "$TITLE · Display" --msgbox "This screen doesn't offer other resolutions." 8 $W
    return
  fi
  local choice
  choice=$(whiptail --title "$TITLE · Display" --menu "Choose a screen resolution:" $H $W 12 "${items[@]}" 3>&1 1>&2 2>&3) || return
  wlr-randr --output "$OUTPUT" --mode "$choice" 2>/dev/null
  if whiptail --title "$TITLE · Display" --yesno "Keep this resolution?" 8 $W; then
    MODE="$choice"; save_display
  elif [ -n "$current" ]; then
    wlr-randr --output "$OUTPUT" --mode "$current" 2>/dev/null
  fi
}

pick_scale() {
  local choice
  choice=$(whiptail --title "$TITLE · Display" --menu "Make text and buttons bigger or smaller:" $H $W 6 \
    1    "100%  normal" \
    1.25 "125%  larger" \
    1.5  "150%  large" \
    1.75 "175%  extra large" \
    2    "200%  huge" 3>&1 1>&2 2>&3) || return
  wlr-randr --output "$OUTPUT" --scale "$choice" 2>/dev/null
  SCALE="$choice"; save_display
}

display_setup() {
  load_display
  pick_output || return
  local choice
  while true; do
    choice=$(whiptail --title "$TITLE · Display" --menu "Display settings for $OUTPUT" $H $W 4 \
      resolution "Screen resolution" \
      size       "Text and button size" \
      "back"     "Back" 3>&1 1>&2 2>&3) || return
    case "$choice" in
      resolution) pick_resolution ;;
      size)       pick_scale ;;
      *)          return ;;
    esac
  done
}

# ---------- Sound ----------
sound_volume() {
  wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{v=int($2*100+0.5); m=($0 ~ /MUTED/) ? " (muted)" : ""; print v "%" m}'
}

pick_output_device() {
  local items=() id name
  while IFS='|' read -r id name; do
    items+=("$id" "$name")
  done < <(wpctl status 2>/dev/null | awk '
      /Audio/ {audio=1} /Video/ {audio=0}
      audio && /Sinks:/ {s=1; next}
      s && /(Sources|Filters|Streams):/ {s=0}
      s && /[0-9]+\./ {
        line=$0; gsub(/[│├└─*]/, "", line); sub(/\[vol:.*/, "", line)
        match(line, /[0-9]+\./); id=substr(line, RSTART, RLENGTH-1)
        name=substr(line, RSTART+RLENGTH); gsub(/^ +| +$/, "", name)
        print id "|" name
      }')
  if [ "${#items[@]}" -eq 0 ]; then
    whiptail --title "$TITLE · Sound" --msgbox "No speakers or headphones were found on this PC." 8 $W
    return
  fi
  id=$(whiptail --title "$TITLE · Sound" --menu "Play sound through:" $H $W 12 "${items[@]}" 3>&1 1>&2 2>&3) || return
  wpctl set-default "$id"
}

sound_menu() {
  local choice chime
  while true; do
    if [ -f "$CONF/startup-sound-off" ]; then chime="Startup sound: OFF (turn on)"; else chime="Startup sound: ON (turn off)"; fi
    choice=$(whiptail --title "$TITLE · Sound" --menu "Volume: $(sound_volume)" $H $W 8 \
      up      "Volume up" \
      down    "Volume down" \
      mute    "Mute / unmute" \
      output  "Speakers, headphones or HDMI" \
      test    "Play a test sound" \
      startup "$chime" \
      "back"  "Back" 3>&1 1>&2 2>&3) || return
    case "$choice" in
      up)     wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+ ;;
      down)   wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%- ;;
      mute)   wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      output) pick_output_device ;;
      test)   pw-play /usr/share/eagle/sounds/startup.wav 2>/dev/null \
                || whiptail --title "$TITLE · Sound" --msgbox "Couldn't play the test sound." 8 $W ;;
      startup)
        if [ -f "$CONF/startup-sound-off" ]; then
          rm -f "$CONF/startup-sound-off"; pw-play /usr/share/eagle/sounds/startup.wav 2>/dev/null &
        else
          touch "$CONF/startup-sound-off"
        fi ;;
      *)      return ;;
    esac
  done
}

# ---------- Updates (Debian 13 underneath) ----------
updates_menu() {
  local st auto live last choice count rc
  while true; do
    st=$(sudo -n /usr/local/sbin/eagle-update status 2>/dev/null)
    auto=$(echo "$st" | sed -n 's/.*auto=\([a-z]*\).*/\1/p')
    live=$(echo "$st" | sed -n 's/.*live=\([a-z]*\).*/\1/p')
    last="${st#*last=}"
    if [ "$auto" = "on" ]; then toggle="Turn automatic updates OFF"; else toggle="Turn automatic updates ON"; fi
    choice=$(whiptail --title "$TITLE · Updates" --menu \
      "Automatic updates: ${auto:-unknown}\nLast installed from this menu: ${last:-never}" $H $W 5 \
      check  "Check for updates" \
      now    "Install updates now" \
      auto   "$toggle" \
      back   "Back" 3>&1 1>&2 2>&3) || return
    case "$choice" in
      check)
        whiptail --title "$TITLE · Updates" --infobox "Checking Debian for updates..." 7 $W
        count=$(sudo -n /usr/local/sbin/eagle-update check 2>/dev/null)
        case "$count" in
          offline|"") whiptail --title "$TITLE · Updates" --msgbox "Couldn't reach the update servers. Check Wi-Fi and try again." 8 $W ;;
          0)          whiptail --title "$TITLE · Updates" --msgbox "EAGLE-OS is up to date." 8 $W ;;
          *)          whiptail --title "$TITLE · Updates" --msgbox "$count updates are available. Choose \"Install updates now\"." 8 $W ;;
        esac ;;
      now)
        if [ "$live" = "yes" ]; then
          whiptail --title "$TITLE · Updates" --msgbox "EAGLE-OS is running straight from the USB stick or card, so updates would be lost at restart.\n\nInstall EAGLE-OS to keep it updated." 11 $W
          continue
        fi
        clear
        echo "EAGLE-OS updates"; echo "----------------"
        sudo -n /usr/local/sbin/eagle-update now; rc=$?
        echo
        if [ "$rc" -eq 10 ]; then
          if whiptail --title "$TITLE · Updates" --yesno "Updates installed. Restart now to finish?" 8 $W; then systemctl reboot; exit 0; fi
        elif [ "$rc" -eq 0 ]; then
          whiptail --title "$TITLE · Updates" --msgbox "Updates installed." 8 $W
        else
          whiptail --title "$TITLE · Updates" --msgbox "Updating didn't finish. Check the network and try again." 8 $W
        fi ;;
      auto)
        if [ "$auto" = "on" ]; then sudo -n /usr/local/sbin/eagle-update auto-off; else sudo -n /usr/local/sbin/eagle-update auto-on; fi ;;
      *) return ;;
    esac
  done
}

# ---------- Disks (GParted) ----------
disks_gparted() {
  whiptail --title "$TITLE · Disks" --yesno "GParted shows and changes the drives and partitions in this PC.\n\nChanges you apply in GParted can erase data. Close GParted to come back here.\n\nOpen GParted?" 13 $W || return
  sudo -n /usr/local/sbin/eagle-gparted "${WAYLAND_DISPLAY:-}" "${XDG_RUNTIME_DIR:-}" "${DISPLAY:-}" >/dev/null 2>&1
}

# ---------- Security (antivirus) ----------
security_scan() { # $1 = downloads | home | full
  local label=$1 out found
  case "$1" in downloads) label="your Downloads folder" ;; home) label="all your files" ;; full) label="the whole system (this can take an hour)" ;; esac
  clear
  printf '\n  \033[1;33mEAGLE-OS Security\033[0m\n\n  Scanning %s...\n  Please wait. Infected files are moved to quarantine.\n\n' "$label"
  out=$(sudo -n /usr/local/sbin/eagle-security scan "$1" 2>&1 | tee /dev/tty)
  found=$(echo "$out" | sed -n 's/.*SCAN_RESULT .*infected=\([0-9]*\).*/\1/p' | tail -n1)
  if [ -z "$found" ]; then
    whiptail --title "$TITLE · Security" --msgbox "The scan didn't finish. Check the network (virus definitions are needed) and try again." 9 $W
  elif [ "$found" = "0" ]; then
    whiptail --title "$TITLE · Security" --msgbox "Scan complete: no threats found." 8 $W
  else
    whiptail --title "$TITLE · Security" --msgbox "Scan complete: $found threat(s) found and moved to quarantine.\n\nThey can't run or be opened there. You can delete them from Quarantine." 11 $W
  fi
}

security_menu() {
  local choice summary qn
  while true; do
    summary=$(sudo -n /usr/local/sbin/eagle-security status-text 2>/dev/null)
    qn=$(sudo -n /usr/local/sbin/eagle-security quarantine-list 2>/dev/null | wc -l)
    choice=$(whiptail --title "$TITLE · Security" --menu "$summary" 22 $W 7 \
      downloads "Scan Downloads now" \
      home      "Scan all my files" \
      full      "Full system scan (slow)" \
      update    "Update virus definitions" \
      quarantine "Quarantine ($qn file(s))" \
      "back"    "Back" 3>&1 1>&2 2>&3) || return
    case "$choice" in
      downloads|home|full)
        if is_live && ! sudo -n /usr/local/sbin/eagle-security status 2>/dev/null | grep -q '"signatures": "'; then
          whiptail --title "$TITLE · Security" --yesno "EAGLE-OS is running from the USB stick, so the virus definitions (about 250 MB) will download into memory and be lost at restart.\n\nContinue?" 11 $W || continue
        fi
        security_scan "$choice" ;;
      update)
        clear; printf '\n  \033[1;33mEAGLE-OS Security\033[0m\n\n  Updating virus definitions...\n\n'
        if sudo -n /usr/local/sbin/eagle-security update; then
          whiptail --title "$TITLE · Security" --msgbox "Virus definitions are up to date." 8 $W
        else
          whiptail --title "$TITLE · Security" --msgbox "Couldn't update the virus definitions. Check the network and try again." 9 $W
        fi ;;
      quarantine)
        if [ "$qn" -eq 0 ]; then
          whiptail --title "$TITLE · Security" --msgbox "Quarantine is empty." 8 $W
        elif whiptail --title "$TITLE · Security" --yesno "Quarantined files:\n\n$(sudo -n /usr/local/sbin/eagle-security quarantine-list | head -n 10)\n\nDelete them permanently?" 20 $W; then
          sudo -n /usr/local/sbin/eagle-security quarantine-delete
        fi ;;
      *) return ;;
    esac
  done
}

# ---------- Date and time ----------
dt_status() { sudo -n /usr/local/sbin/eagle-datetime status 2>/dev/null; }

pick_timezone() {
  local z region regions=() cities=()
  z=$(whiptail --title "$TITLE · Time zone" --menu "Choose your time zone:" $H $W 9 \
      America/New_York    "Eastern (New York, Louisville, Atlanta)" \
      America/Chicago     "Central (Chicago, Dallas, Nashville)" \
      America/Denver      "Mountain (Denver, Salt Lake City)" \
      America/Phoenix     "Arizona (no daylight saving)" \
      America/Los_Angeles "Pacific (Los Angeles, Seattle)" \
      America/Anchorage   "Alaska" \
      Pacific/Honolulu    "Hawaii" \
      UTC                 "UTC" \
      other               "Other time zones..." 3>&1 1>&2 2>&3) || return
  if [ "$z" = "other" ]; then
    mapfile -t regions < <(timedatectl list-timezones 2>/dev/null | awk -F/ 'NF>1 {print $1}' | sort -u)
    local items=(); for region in "${regions[@]}"; do items+=("$region" "$region"); done
    region=$(whiptail --title "$TITLE · Time zone" --menu "Region:" $H $W 10 "${items[@]}" 3>&1 1>&2 2>&3) || return
    mapfile -t cities < <(timedatectl list-timezones 2>/dev/null | grep "^$region/")
    items=(); for z in "${cities[@]}"; do items+=("$z" "${z#*/}"); done
    z=$(whiptail --title "$TITLE · Time zone" --menu "City:" $H $W 10 "${items[@]}" 3>&1 1>&2 2>&3) || return
  fi
  sudo -n /usr/local/sbin/eagle-datetime zone "$z" \
    || whiptail --title "$TITLE · Time zone" --msgbox "Couldn't change the time zone." 8 $W
}

set_time_by_hand() {
  local d t when
  d=$(whiptail --title "$TITLE · Date" --inputbox "Today's date (year-month-day), for example $(date +%Y-%m-%d):" 10 $W "$(date +%Y-%m-%d)" 3>&1 1>&2 2>&3) || return
  t=$(whiptail --title "$TITLE · Time" --inputbox "The time now, for example 2:30 PM or 14:30:" 10 $W "$(date '+%-I:%M %p')" 3>&1 1>&2 2>&3) || return
  if ! when=$(date -d "$d $t" '+%Y-%m-%d %H:%M' 2>/dev/null); then
    whiptail --title "$TITLE · Date and time" --msgbox "That date or time wasn't understood. Try again, e.g. 2026-11-23 and 2:30 PM." 9 $W
    return
  fi
  if sudo -n /usr/local/sbin/eagle-datetime set "$when"; then
    whiptail --title "$TITLE · Date and time" --msgbox "Date and time set to $(date '+%A, %B %-d, %Y  %-I:%M %p').\n\nAutomatic time is now off. Turn it back on any time from this screen." 11 $W
  else
    whiptail --title "$TITLE · Date and time" --msgbox "Couldn't set the date and time." 8 $W
  fi
}

datetime_menu() {
  local st auto tz choice toggle
  while true; do
    st=$(dt_status); auto=$(echo "$st" | sed -n 's/.*auto=\([a-z]*\).*/\1/p'); tz=$(echo "$st" | sed -n 's/.*tz=\(.*\)$/\1/p')
    if [ "$auto" = "on" ]; then toggle="Automatic time: ON (turn off)"; else toggle="Automatic time: OFF (turn on)"; fi
    choice=$(whiptail --title "$TITLE · Date and time" --menu "$(date '+%A, %B %-d, %Y   %-I:%M %p')\nTime zone: ${tz:-unknown}\nAutomatic time from the internet: ${auto:-unknown}" $H $W 5 \
      auto   "$toggle" \
      zone   "Change time zone" \
      manual "Set date and time by hand" \
      "back" "Back" 3>&1 1>&2 2>&3) || return
    case "$choice" in
      auto)
        if [ "$auto" = "on" ]; then sudo -n /usr/local/sbin/eagle-datetime auto off
        else sudo -n /usr/local/sbin/eagle-datetime auto on
             whiptail --title "$TITLE · Date and time" --msgbox "Automatic time is on. The clock corrects itself within a minute when the PC is online." 9 $W
        fi ;;
      zone)   pick_timezone ;;
      manual) set_time_by_hand ;;
      *)      return ;;
    esac
  done
}

# ---------- Install ----------
is_live() { [ -d /run/live/medium ]; }
install_eagle() { sudo -n /usr/local/sbin/eagle-install; }

# ---------- Main ----------
# Let the full-screen terminal finish sizing itself before drawing (keeps boxes centred)
prev=""; for _ in $(seq 1 15); do cur="$(tput cols 2>/dev/null)x$(tput lines 2>/dev/null)"; [ "$cur" = "$prev" ] && break; prev=$cur; sleep 0.2; done
if [ "$MODE_ARG" = "--action" ]; then
  case "$ACTION_ARG" in
    wifi)    wifi_setup ;;
    display) display_setup ;;
    sound)   sound_menu ;;
    datetime) datetime_menu ;;
    disks)   disks_gparted ;;
    security) security_menu ;;
    updates) updates_menu ;;
    install) install_eagle ;;
    *)       MODE_ARG="--menu" ;;
  esac
  [ "$MODE_ARG" = "--action" ] && exit 0
fi

if [ "$MODE_ARG" = "--first-run" ]; then
  whiptail --title "$TITLE" --msgbox "Welcome to EAGLE-OS by Stumpf Technology.\n\nLet's get you online. Use the arrow keys and Enter.\n\nLater, the orange E button in Firefox's toolbar brings you back here." 13 $W
fi

while true; do
  items=(browse "Start browsing" wifi "Wi-Fi and network" display "Display and screen size" sound "Sound" datetime "Date and time")
  if [ "$MODE_ARG" = "--menu" ]; then
    items+=(security "Security (antivirus)" disks "Disks and partitions (GParted)" updates "Updates")
  fi
  if is_live; then
    items+=(install "Install EAGLE-OS on this PC (wipes a drive)")
  fi
  if [ "$MODE_ARG" = "--menu" ]; then
    items+=(restart "Restart" shutdown "Shut down")
  fi
  choice=$(whiptail --title "$TITLE" --menu "$(net_status)" $H $W 12 "${items[@]}" 3>&1 1>&2 2>&3) || choice=browse
  case "$choice" in
    wifi)     wifi_setup ;;
    display)  display_setup ;;
    sound)    sound_menu ;;
    datetime) datetime_menu ;;
    disks)    disks_gparted ;;
    security) security_menu ;;
    updates)  updates_menu ;;
    install)  install_eagle ;;
    restart)  systemctl reboot; exit 0 ;;
    shutdown) systemctl poweroff; exit 0 ;;
    browse|*) touch "$CONF/setup-done"; exit 0 ;;
  esac
done

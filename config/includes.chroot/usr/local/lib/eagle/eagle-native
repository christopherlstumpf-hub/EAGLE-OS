#!/usr/bin/python3
"""EAGLE-OS menu helper for the Firefox toolbar button and start page.

Firefox talks to it through native messaging (length-prefixed JSON on stdin/stdout).
Actions that need a full-screen EAGLE screen (Wi-Fi, Display, Sound, Disks/GParted,
Updates, Install, Menu) are handed to the EAGLE session: the request is written to a file and
Firefox is closed; the session opens that screen, then reopens Firefox.
"""
import json, os, struct, subprocess, sys

SCREENS = {"wifi", "display", "sound", "datetime", "disks", "security", "updates", "install", "menu"}
REQUEST = os.path.expanduser("~/.config/eagle/request")


def read_msg():
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        sys.exit(0)
    (n,) = struct.unpack("@I", raw)
    return json.loads(sys.stdin.buffer.read(n).decode("utf-8"))


def send(obj):
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(data)) + data)
    sys.stdout.buffer.flush()


def read(path, cast=str):
    try:
        with open(path) as f:
            return cast(f.read().strip())
    except (OSError, ValueError):
        return None


def battery():
    """Battery level and charger state from /sys/class/power_supply (all batteries combined)."""
    base = "/sys/class/power_supply"
    try:
        names = sorted(os.listdir(base))
    except OSError:
        names = []
    bats, plugged = [], None
    for n in names:
        d = os.path.join(base, n)
        kind = read(d + "/type")
        if kind == "Mains":
            on = read(d + "/online", int)
            if on is not None:
                plugged = bool(on) or bool(plugged)
        elif kind == "Battery" and read(d + "/scope") != "Device":   # skip mice and keyboards
            if read(d + "/present", int) == 0:
                continue
            bats.append(d)
    if not bats:
        return {"ok": True, "present": False}
    now = full = rate = 0.0
    pcts, statuses = [], []
    for d in bats:
        st = read(d + "/status") or "Unknown"
        statuses.append(st)
        cap = read(d + "/capacity", int)
        e_now = read(d + "/energy_now", float) or read(d + "/charge_now", float)
        e_full = read(d + "/energy_full", float) or read(d + "/charge_full", float)
        r = read(d + "/power_now", float) or read(d + "/current_now", float)
        if e_now is not None and e_full:
            now += e_now; full += e_full
        elif cap is not None:
            pcts.append(cap)
        if r:
            rate += abs(r)
    percent = round(100 * now / full) if full else (round(sum(pcts) / len(pcts)) if pcts else None)
    if percent is not None:
        percent = max(0, min(100, percent))
    charging = "Charging" in statuses
    discharging = "Discharging" in statuses
    if plugged is None:
        plugged = not discharging
    minutes = None
    if rate > 0 and full:
        if discharging:
            minutes = round(60 * now / rate)
        elif charging:
            minutes = round(60 * (full - now) / rate)
        if minutes is not None and not 0 < minutes < 48 * 60:
            minutes = None
    return {"ok": True, "present": True, "percent": percent, "charging": charging,
            "plugged": bool(plugged) and not discharging, "full": "Full" in statuses or (percent == 100 and not discharging),
            "minutes": minutes}


def main():
    msg = read_msg()
    action = str(msg.get("action", ""))
    live = os.path.isdir("/run/live/medium")
    if action == "status":
        try:
            variant = open("/etc/eagle/variant").read().strip()
        except OSError:
            variant = "standard"
        send({"ok": True, "live": live, "variant": variant})
    elif action == "camera_status":
        facetime = False
        for d in os.listdir("/sys/bus/pci/devices"):
            if read(f"/sys/bus/pci/devices/{d}/vendor") == "0x14e4" and read(f"/sys/bus/pci/devices/{d}/device") == "0x1570":
                facetime = True
        videos = [v for v in os.listdir("/dev") if v.startswith("video")]
        send({"ok": True, "facetime": facetime, "videos": len(videos),
              "firmware": os.path.exists("/lib/firmware/facetimehd/firmware.bin"),
              "state": read("/run/eagle-facetime-state") or "starting"})
    elif action == "camera_retry":
        subprocess.Popen(["sudo", "-n", "/usr/bin/systemctl", "restart", "eagle-facetime-firmware.service"])
        send({"ok": True})
    elif action == "battery":
        send(battery())
    elif action == "security_status":
        try:
            st = json.load(open("/var/lib/eagle/security.json"))
        except (OSError, ValueError):
            st = {}
        try:
            newest = max(os.path.getmtime(os.path.join("/var/lib/clamav", f))
                         for f in os.listdir("/var/lib/clamav") if f.endswith((".cvd", ".cld")))
            import datetime
            st["signatures"] = datetime.datetime.fromtimestamp(newest).astimezone().isoformat(timespec="seconds")
        except (OSError, ValueError):
            pass
        st["realtime"] = subprocess.run(["systemctl", "is-active", "--quiet", "eagle-clamonacc.service"]).returncode == 0
        st["live"] = live
        st["ok"] = True
        send(st)
    elif action in SCREENS:
        if action == "install" and not live:
            send({"ok": False, "error": "EAGLE-OS is already installed."})
            return
        os.makedirs(os.path.dirname(REQUEST), exist_ok=True)
        with open(REQUEST, "w") as f:
            f.write(action + "\n")
        send({"ok": True})
        sys.stdout.flush()
        # Close Firefox; the EAGLE session opens the screen and reopens Firefox afterwards.
        subprocess.Popen(["pkill", "-TERM", "-x", "firefox-esr"])
    elif action == "restart":
        send({"ok": True})
        subprocess.Popen(["systemctl", "reboot"])
    elif action == "shutdown":
        send({"ok": True})
        subprocess.Popen(["systemctl", "poweroff"])
    else:
        send({"ok": False, "error": "unknown action"})


if __name__ == "__main__":
    main()

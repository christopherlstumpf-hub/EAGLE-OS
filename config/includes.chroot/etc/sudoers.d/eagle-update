# The EAGLE menu may run the updater, the installer, GParted, the antivirus and date/time settings, and nothing else, as root.
# (The installer only works while EAGLE-OS is running from the USB stick / card.)
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/eagle-update
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/eagle-install
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/eagle-gparted
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/eagle-security
kiosk ALL=(root) NOPASSWD: /usr/local/sbin/eagle-datetime

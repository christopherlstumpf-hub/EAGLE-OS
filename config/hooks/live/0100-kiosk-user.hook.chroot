#!/bin/sh
# Creates the locked "kiosk" account the browser runs as, boots to greetd,
# and installs the EAGLE-OS startup splash.
set -e

if ! id kiosk >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash kiosk
fi
passwd --lock kiosk

for group in video audio input render netdev; do
  if getent group "$group" >/dev/null; then
    usermod -aG "$group" kiosk
  fi
done

chmod 0755 /usr/local/bin/eagle-session /usr/local/bin/eagle-browser /usr/local/bin/eagle-setup /usr/local/sbin/eagle-update
chmod 0440 /etc/sudoers.d/eagle-update
chmod 0755 /usr/local/sbin/eagle-install /usr/local/sbin/eagle-gparted /usr/local/sbin/eagle-datetime /usr/local/lib/eagle/eagle-native
# Default time zone (changeable in Date and time); automatic time on
ln -sf /usr/share/zoneinfo/America/New_York /etc/localtime
echo America/New_York > /etc/timezone
systemctl enable systemd-timesyncd.service 2>/dev/null || true
systemctl enable greetd.service
systemctl enable NetworkManager.service
systemctl enable zramswap.service
systemctl set-default graphical.target

# Startup splash: chrome EAGLE-OS on black
plymouth-set-default-theme eagle
update-initramfs -u -k all || true  # live-build also rebuilds it later

# F9 / F10 volume keys
chmod 0755 /usr/local/bin/eagle-volume /usr/local/bin/eagle-brightness /usr/local/bin/eagle-media /usr/local/bin/eagle-kbdlight /usr/local/bin/eagle-key /usr/local/bin/eagle-notify
systemd-hwdb update
systemctl enable triggerhappy.service 2>/dev/null || true

# Battery: shut down cleanly at 3% instead of running flat (protects files on eMMC / SSD)
if [ -f /etc/UPower/UPower.conf ]; then
  sed -i -e 's/^PercentageLow=.*/PercentageLow=20/' -e 's/^PercentageCritical=.*/PercentageCritical=5/' \
         -e 's/^PercentageAction=.*/PercentageAction=3/' -e 's/^CriticalPowerAction=.*/CriticalPowerAction=PowerOff/' /etc/UPower/UPower.conf
fi

# Google Chrome (standard edition, installed from the EAGLE menu > Web browser)
chmod 0755 /usr/local/sbin/eagle-chrome

# Printers: EAGLE menu > Printers (eagle-printers runs as root via sudo)
chmod 0755 /usr/local/sbin/eagle-printers
systemctl enable cups.service avahi-daemon.service 2>/dev/null || true

# Mac support: camera firmware download (does nothing on other PCs)
chmod 0755 /usr/local/sbin/eagle-facetime-firmware
systemctl enable eagle-facetime-firmware.service
chmod 0755 /usr/local/sbin/eagle-mac-drivers /etc/kernel/postinst.d/zz-eagle-mac-check
systemctl enable eagle-mac-drivers.service

#!/bin/sh
# EAGLE-OS boot menu: runs on the finished boot files, just before the ISO is made.
#  - black chrome splash with "by Stumpf Technology", menu below the logo, orange highlight
#  - "Run EAGLE-OS", "Install EAGLE-OS (wipes a drive)" (opens the EAGLE installer)
#    and "Run EAGLE-OS (safe graphics)" (for graphics chips that won't start)
#  - the Debian installer stays available as "Advanced: Debian installer"
set -e

# Binary hooks run inside binary/; find the art either way.
if [ -d ../config/branding ]; then ART=../config/branding; else ART=config/branding; cd binary; fi
echo "EAGLE boot menu: branding $(pwd)"

# ---- Splash pictures ----
find . -name 'splash.png' -type f | while read -r f; do
  case "$f" in
    *isolinux*|*syslinux*) cp "$ART/menu-640x480.png" "$f" ;;
    *)                     cp "$ART/menu-1920x1080.png" "$f" ;;
  esac
  echo "  splash: $f"
done

# ---- Labels and colors ----
find . \( -path ./live -prune \) -o -type f \( -name '*.cfg' -o -name 'theme.txt' \) -print | while read -r f; do
  sed -i -E \
    -e 's/Live system \([^)]*fail-safe[^)]*\)/Run EAGLE-OS (safe mode)/g' \
    -e 's/Live system \([^)]*\)/Run EAGLE-OS/g' \
    -e 's/Live system/Run EAGLE-OS/g' \
    -e "s/menuentry ([\"'])(Install|Start installer)([\"'])/menuentry \1Advanced: Debian installer\3/" \
    -e 's/(menu label )\^?(Install|Start installer)$/\1Advanced: ^Debian installer/' \
    -e 's/menu label Start \^installer$/menu label Advanced: ^Debian installer/' \
    -e 's/^([[:space:]]*menu color (sel|hotsel)[[:space:]]+[^[:space:]]+[[:space:]]+)[^[:space:]]+[[:space:]]+[^[:space:]]+/\1#ff000000 #ffff7a00/' \
    -e 's/^([[:space:]]*menu color (unsel|title|tabmsg|timeout_msg|help)[[:space:]]+[^[:space:]]+[[:space:]]+)[^[:space:]]+/\1#ffd6d6d6/' \
    -e 's/^([[:space:]]*selected_item_color[[:space:]]*=[[:space:]]*).*/\1"#ff7a00"/' \
    -e 's/^([[:space:]]*item_color[[:space:]]*=[[:space:]]*).*/\1"#d6d6d6"/' \
    -e 's/^([[:space:]]*set menu_color_highlight=).*/\1black\/brown/' \
    -e 's/^([[:space:]]*set menu_color_normal=).*/\1light-gray\/black/' \
    -e 's/^([[:space:]]*set color_highlight=).*/\1black\/brown/' \
    -e 's/^([[:space:]]*set color_normal=).*/\1light-gray\/black/' \
    "$f"
done

# ---- GRUB (UEFI and newer PCs): extra entries right after the first "Run EAGLE-OS" ----
# add_grub_entry FILE "TITLE" HOTKEY "EXTRA KERNEL OPTIONS"
add_grub_entry() {
  awk -v title="$2" -v hotkey="$3" -v extra="$4" '
    !done && !inblk && /menuentry "Run EAGLE-OS"/ { inblk = 1; n = 0 }
    inblk { blk[++n] = $0 }
    { print }
    inblk && /^[[:space:]]*}[[:space:]]*$/ {
      inblk = 0; done = 1
      for (i = 1; i <= n; i++) {
        l = blk[i]
        if (i == 1) { sub(/"Run EAGLE-OS"/, "\"" title "\"", l); sub(/--hotkey=[a-z]/, "--hotkey=" hotkey, l) }
        if (l ~ /^[[:space:]]*linux/) l = l " " extra
        print l
      }
    }' "$1" > "$1.new" && mv "$1.new" "$1"
}
for f in $(grep -rl 'menuentry "Run EAGLE-OS"' boot/grub 2>/dev/null || true); do
  # added in reverse: each lands right after "Run EAGLE-OS"
  add_grub_entry "$f" "Run EAGLE-OS (safe graphics)" g "nomodeset eagle.safegfx=1"
  add_grub_entry "$f" "Install EAGLE-OS (wipes a drive)" e "eagle.install=1"
  echo "  grub entries added: $f"
done

# Keep the GRUB menu below the logo
find boot/grub -name theme.txt 2>/dev/null | while read -r f; do
  sed -i -E '/\+[[:space:]]*boot_menu/,/}/ {
    s/^([[:space:]]*top[[:space:]]*=[[:space:]]*).*/\155%/
    s/^([[:space:]]*height[[:space:]]*=[[:space:]]*).*/\138%/
  }' "$f"
done

# ---- ISOLINUX (older BIOS PCs): same extra entries, menu moved below the logo ----
# add_isolinux_entry "LABEL" "MENU TITLE" "EXTRA KERNEL OPTIONS"
add_isolinux_entry() {
  awk -v name="$1" -v title="$2" -v extra="$3" '
    function flush(   i, l) {
      if (!n) return
      for (i = 1; i <= n; i++) print blk[i]
      if (!done && islive) {
        print ""
        for (i = 1; i <= n; i++) {
          l = blk[i]
          if (l ~ /^label /) l = "label " name
          else if (l ~ /menu label/) l = "\tmenu label " title
          else if (l ~ /menu default/) continue
          else if (l ~ /^[[:space:]]*append /) l = l " " extra
          print l
        }
        done = 1
      }
      n = 0; islive = 0
    }
    /^label / { flush() }
    { if (/^label / || n) { blk[++n] = $0; if ($0 ~ /menu label \^?Run EAGLE-OS$/) islive = 1; next } print }
    END { flush() }' isolinux/live.cfg > isolinux/live.cfg.new && mv isolinux/live.cfg.new isolinux/live.cfg
}
if [ -f isolinux/live.cfg ]; then
  add_isolinux_entry eagle-safegfx "Run EAGLE-OS (safe ^graphics)" "nomodeset eagle.safegfx=1"
  add_isolinux_entry eagle-install "^Install EAGLE-OS (wipes a drive)" "eagle.install=1"
  echo "  isolinux entries added"
fi
if [ -f isolinux/stdmenu.cfg ]; then
  printf 'menu vshift 13\nmenu rows 9\nmenu margin 6\n' >> isolinux/stdmenu.cfg
fi

echo "EAGLE boot menu: done"

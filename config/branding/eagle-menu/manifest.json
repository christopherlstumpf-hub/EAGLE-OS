{
  "manifest_version": 2,
  "name": "EAGLE-OS menu",
  "version": "1.3",
  "description": "EAGLE-OS start page and menu: Wi-Fi, Display, Sound, Date and time, Camera, calendar links, Security, Disks, Updates, screen timeout and screensaver",
  "browser_specific_settings": {
    "gecko": {
      "id": "menu@eagle-os"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "icons": {
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "browser_action": {
    "default_icon": {
      "64": "icon-64.png",
      "128": "icon-128.png"
    },
    "default_title": "EAGLE-OS menu",
    "default_popup": "popup.html",
    "default_area": "navbar"
  },
  "background": {
    "scripts": [
      "ical.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "activity.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

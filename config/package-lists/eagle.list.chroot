# The browser
firefox-esr

# Login + single-app display (Wayland kiosk compositor)
greetd
cage
xwayland
foot

# Networking (Wi-Fi setup screen uses nmtui)
network-manager
wpasupplicant

# Hardware support: firmware for common Wi-Fi and graphics chips
firmware-linux
firmware-linux-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
libgl1-mesa-dri
mesa-vulkan-drivers
mesa-va-drivers

# Sound: generic kernel drivers (HD Audio, USB audio, HDMI) are built into the Debian kernel;
# these add the sound server, device profiles, and firmware for newer Intel laptop audio.
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils
alsa-ucm-conf
firmware-sof-signed

# Session plumbing
dbus-user-session
systemd-timesyncd
ca-certificates

# Fonts
fonts-noto-core
fonts-noto-color-emoji

# Keep itself patched automatically
unattended-upgrades

# Older PCs: compressed RAM swap + video decode on older Intel graphics
zram-tools
i965-va-driver

# EAGLE-OS look and setup screens
plymouth
whiptail
wlr-randr
fonts-dejavu-core

# Updates screen (lets the kiosk user run only the EAGLE updater as root)
sudo

# EAGLE installer (wipe + install) and the toolbar button helper
squashfs-tools
dosfstools
grub-pc-bin
grub-efi-amd64-bin
grub2-common
efibootmgr
python3

# Basic-display fallback for PCs with no usable graphics driver (no DRM device)
xserver-xorg-core
xserver-xorg-video-fbdev
xserver-xorg-video-vesa
xserver-xorg-input-libinput
xserver-xorg-legacy
xinit
x11-xserver-utils
matchbox-window-manager
xterm

# Disks and partitions (GParted) with support for Windows (NTFS) and exFAT drives
gparted
ntfs-3g
exfatprogs

# Intel Atom/Celeron (Bay Trail, Braswell, Cherry Trail) sound chips, e.g. Acer Cloudbook
firmware-intel-sound

# Antivirus (ClamAV): definitions updates, scans, real-time watch of Downloads on 4 GB+ PCs
clamav
clamav-freshclam
clamav-daemon

# F9 / F10 volume keys on the built-in keyboard (works in every screen)
triggerhappy

# Mac support: firmware download for the FaceTime camera
curl
make
xz-utils

# Battery: safe shutdown when nearly empty
upower

# Printing: driverless network/USB printers (AirPrint, IPP Everywhere, Mopria) plus HP and Gutenprint drivers
cups
cups-filters
ipp-usb
avahi-daemon
libnss-mdns
printer-driver-hpcups
printer-driver-gutenprint

# Google Chrome needs these (Chrome itself is downloaded from Google when chosen)
fonts-liberation
libcurl3t64-gnutls
libvulkan1
wget
xdg-utils

# Media keys (play/pause, next, previous) for the browser
playerctl

# HP printers: HP's own printer connection (older network and USB HP printers)
hplip
# notification receiver (website pop-ups -> Notifications panel)
python3-gi
gir1.2-glib-2.0
libnotify4
libglib2.0-bin
